    "allsudoku": {
      "name": "全部數獨",
      "tagline": "5種數獨，每日全球競賽",
      "blurb": "原始、大於、殺手、計算、符號五種數獨集於一個應用。五個等級無限謎題，支援筆記、撤銷和提示，每天還能與全球玩家挑戰同一道每日數獨。"
    },
    "blockdoku": {
      "name": "塊獨-數獨+方塊拼圖",
      "tagline": "數獨與方塊拼圖，連擊得高分",
      "blurb": "數獨與積木拼圖的結合。在9x9網格中用方塊填滿橫行、直列或九宮格即可消除。一次消除多行可獲得連擊加分，與全球玩家爭奪最高分。"
    },
    "dropnumber": {
      "name": "Drop&Shot Number",
      "tagline": "掉落與發射數字，2048式合併",
      "blurb": "兩款2048式遊戲：把下落的數字放進某一列的DropNumber，以及從底部發射數字的ShotNumber。相同數字會連鎖合併成更大的數字。5x5、7x7、9x9地圖。"
    },
    "minesweeper": {
      "name": "掃雷車 - 經典遊戲",
      "tagline": "經典掃雷，與全球玩家競爭",
      "blurb": "經典掃雷玩法：翻開格子、讀懂數字、為地雷插旗。5種地圖尺寸，支援縮放和大地圖遙控，未完成的遊戲自動保存，與全球玩家比拼最佳成績。"
    },
    "tenten": {
      "name": "1010!2",
      "tagline": "1010! 方塊拼圖，可撤銷",
      "blurb": "可撤銷的1010!。在10x10網格中放置方塊，填滿橫行或直列即可消除。一次消除多行可獲得連擊加分，危急時刻還能撤銷一步。"
    },
