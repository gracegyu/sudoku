source 'https://cdn.cocoapods.org/'

# Apple 이 MinimumOSVersion 12.0 을 더 이상 받지 않는다 (2026-09-19 업로드 거부).
# GitFlutter 의 여섯 앱도 15.0 이라 그쪽에 맞춘다.
platform :ios, '15.0'
# FirebaseCrashlytics 12 는 Swift 팟이라 정적 라이브러리에서 모듈 맵이 필요하다.
use_modular_headers!
target 'sudoku6free' do
pod 'Google-Mobile-Ads-SDK', '~> 13.9'
pod 'FirebaseCrashlytics'
end
target 'sudoku6paid' do
pod 'Google-Mobile-Ads-SDK', '~> 13.9'
pod 'FirebaseCrashlytics'
end
target 'sudoku9free' do
pod 'Google-Mobile-Ads-SDK', '~> 13.9'
pod 'FirebaseCrashlytics'
end
target 'sudoku9paid' do
pod 'Google-Mobile-Ads-SDK', '~> 13.9'
pod 'FirebaseCrashlytics'
end
